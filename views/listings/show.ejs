
<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <!-- LISTING DETAILS -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <h3 class="fw-bold mb-4">Listing Details</h3>

            <div class="card border-0 shadow-sm overflow-hidden"
                 style="border-radius: 16px;">

                <img
                    src="<%= listing.image && listing.image.url ? listing.image.url : 'https://placehold.co/900x500?text=No+Image' %>"
                    class="card-img-top"
                    alt="Listing Image"
                    style="height: 350px; object-fit: cover;"
                >

                <div class="card-body p-4">

                    <p class="text-muted mb-2">
                        Listed by:
                        <strong>
                            <%= listing.owner ? listing.owner.username : "Unknown User" %>
                        </strong>
                    </p>

                    <h4 class="fw-bold mb-3">
                        <%= listing.title %>
                    </h4>

                    <p class="text-muted mb-3">
                        <%= listing.description %>
                    </p>

                    <h5 class="fw-bold mb-2">
                        ₹ <%= listing.price != null
                            ? listing.price.toLocaleString("en-IN")
                            : "Price not available" %>

                        <small class="text-muted fw-normal">
                            / night
                        </small>
                    </h5>

                    <p class="mb-1">
                        <strong>Location:</strong>
                        <%= listing.location %>
                    </p>

                    <p class="mb-0">
                        <strong>Country:</strong>
                        <%= listing.country %>
                    </p>

                    <!-- EDIT AND DELETE BUTTONS -->

                    <% if (currUser && listing.owner &&
                        listing.owner._id.equals(currUser._id)) { %>

                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <a
                                href="/listings/<%= listing._id %>/edit"
                                class="btn btn-danger">
                                Edit Listing
                            </a>

                            <form
                                action="/listings/<%= listing._id %>?_method=DELETE"
                                method="POST"
                                onsubmit="return confirm('Delete this listing?')">

                                <button type="submit" class="btn btn-dark">
                                    Delete Listing
                                </button>

                            </form>

                        </div>

                    <% } %>

                </div>
            </div>

        </div>
    </div>


    <!-- REVIEW SECTION -->

    <section class="review-section mt-5">

        <!-- REVIEW HEADING -->

        <div class="review-heading mb-4">

            <div>
                <h3 class="fw-bold mb-1">Guest Reviews</h3>

                <p class="text-muted mb-0">
                    Share your experience with this property.
                </p>
            </div>

            <span class="review-count">
                <%= listing.reviews.length %>
                <%= listing.reviews.length === 1 ? "Review" : "Reviews" %>
            </span>

        </div>


        <!-- REVIEW FORM -->

        <% if (currUser) { %>

            <div class="review-form-card mb-5">

                <h5 class="fw-bold mb-4">Write a Review</h5>

                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    class="needs-validation"
                    novalidate>

                    <!-- RATING -->

                    <div class="mb-4">

                        <label for="rating" class="form-label fw-semibold">
                            Your Rating
                        </label>

                        <div class="rating-control">

                            <input
                                type="range"
                                class="form-range"
                                min="1"
                                max="5"
                                step="1"
                                id="rating"
                                name="review[rating]"
                                value="5"
                                required
                            >

                            <div class="rating-label">
                                <span>1 - Poor</span>
                                <span>5 - Excellent</span>
                            </div>

                            <div class="selected-rating">

                                <span id="ratingValue">5</span>/5

                                <span id="ratingStars" class="stars">
                                    ★★★★★
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- COMMENT -->

                    <div class="mb-4">

                        <label for="comment" class="form-label fw-semibold">
                            Your Comments
                        </label>

                        <textarea
                            class="form-control review-textarea"
                            id="comment"
                            name="review[comment]"
                            rows="4"
                            maxlength="1000"
                            placeholder="What did you like about this place?"
                            required
                        ></textarea>

                        <div class="form-text">
                            Share your honest experience with this property.
                        </div>

                    </div>


                    <button type="submit" class="review-submit-btn">
                        Submit Review <span>→</span>
                    </button>

                </form>

            </div>

        <% } else { %>

            <div class="alert alert-info mb-5">
                Please <a href="/login">login</a> to write a review.
            </div>

        <% } %>


        <!-- ALL REVIEWS HEADING -->

        <div class="all-reviews-heading mb-4">

            <h4 class="fw-bold mb-1">What Guests Say</h4>

            <p class="text-muted mb-0">
                Read reviews from visitors.
            </p>

        </div>


        <!-- ALL REVIEWS -->

        <% if (listing.reviews.length > 0) { %>

            <div class="row g-4">

                <% listing.reviews.forEach((review) => { %>

                    <div class="col-12 col-md-6">

                        <div class="review-card">

                            <!-- REVIEW HEADER -->

                            <div class="d-flex align-items-center gap-3 mb-3">

                                <div class="review-avatar">
                                    G
                                </div>

                                <div class="flex-grow-1">

                                    <h6 class="fw-bold mb-1">
                                        Guest Review
                                    </h6>

                                    <div class="review-stars">

                                        <% for (let i = 1; i <= 5; i++) { %>

                                            <span class="<%= i <= review.rating
                                                ? 'star-filled'
                                                : 'star-empty' %>">
                                                ★
                                            </span>

                                        <% } %>

                                    </div>

                                </div>

                                <span class="rating-badge">
                                    <%= review.rating %>/5
                                </span>

                            </div>


                            <!-- REVIEW COMMENT -->

                            <p class="review-comment">
                                <%= review.comment || "No comment provided." %>
                            </p>


                            <!-- DELETE REVIEW -->

                            <% if (currUser) { %>

                                <form
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this review?')">

                                    <button
                                        type="submit"
                                        class="review-delete-btn">

                                        Delete Review

                                    </button>

                                </form>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <!-- EMPTY REVIEWS -->

            <div class="empty-reviews">

                <div class="empty-icon">✎</div>

                <h5 class="fw-bold">No reviews yet</h5>

                <p class="text-muted mb-0">
                    Be the first to share your experience!
                </p>

            </div>

        <% } %>


        <!-- MAP SECTION (OUTSIDE REVIEWS LOOP) -->

        <div class="row mt-5">

            <div class="col-12">

                <h3 class="fw-bold mb-3">Where you'll be</h3>

                <div id="map" style="height: 400px; border-radius: 12px;">
                </div>

            </div>

        </div>

    </section>

</div>


<!-- RATING SLIDER SCRIPT -->

<script>

    const ratingInput = document.getElementById("rating");
    const ratingValue = document.getElementById("ratingValue");
    const ratingStars = document.getElementById("ratingStars");

    if (ratingInput && ratingValue && ratingStars) {

        ratingInput.addEventListener("input", function () {

            const rating = Number(this.value);

            ratingValue.textContent = rating;

            ratingStars.textContent =
                "★".repeat(rating) +
                "☆".repeat(5 - rating);

        });

    }

</script>
