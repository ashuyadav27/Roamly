
<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
    }

    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 1rem;
        margin-bottom: 1.25rem;
        opacity: 0.7;
        min-width: 50px;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
        margin-bottom: 0;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        min-height: 3rem;
        padding: 0.8rem 1rem;
        margin-left: auto;
        margin-top: 1rem;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    .listing-link {
        text-decoration: none;
    }

    .card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        height: 100%;
    }

    .card-img-top {
        width: 100%;
        height: 20rem;
        object-fit: cover;
        border-radius: 1rem;
    }

    .card-body {
        padding: 0.5rem 0;
    }

    .card-text {
        color: #222;
    }

    @media (max-width: 768px) {
        .filter {
            margin-right: 1rem;
        }

        .tax-toggle {
            margin-left: 0;
        }
    }
</style>

<div id="filters">

    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain-sun"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beachfront</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-house"></i></div>
        <p>Cabins</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Farms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-chess-rook"></i></div>
        <p>Castles</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="flexSwitchCheckDefault"
            />

            <label
                class="form-check-label"
                for="flexSwitchCheckDefault"
            >
                Display total after taxes
            </label>
        </div>
    </div>

</div>

<% if (success && success.length > 0) { %>
    <% for (let message of success) { %>
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <%= message %>
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    <% } %>
<% } %>

<% if (error && error.length > 0) { %>
    <% for (let message of error) { %>
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <%= message %>
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    <% } %>
<% } %>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

    <% for (let listing of allListings) { %>

        <div class="col">

            <a href="/listings/<%= listing._id %>"
               class="listing-link">

                <div class="card">

                    <img
                        src="<%= listing.image?.url || 'https://placehold.co/600x400?text=Image+Not+Available' %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                    >

                    <div class="card-body">

                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br>

                            &#8377; <%= listing.price %> / night

                            <i class="tax-info">
                                &nbsp;&nbsp;+18% GST
                            </i>
                        </p>

                    </div>

                </div>

            </a>

        </div>

    <% } %>

</div>

<script>
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");

    if (taxSwitch) {
        taxSwitch.addEventListener("change", () => {

            const taxInfo = document.getElementsByClassName("tax-info");

            for (const info of taxInfo) {
                info.style.display = taxSwitch.checked ? "inline" : "none";
            }

        });
    }
</script>
